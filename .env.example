# KSLC 홈페이지가 쓰는 환경변수 목록 (값은 비워둡니다 — 실제 값은 Vercel 에만 있습니다)
# Vercel → 프로젝트 → Settings → Environment Variables 에서 관리합니다.
# 이 파일은 "무엇이 필요한지"를 알려주는 목록일 뿐입니다. 절대 실제 값을 적지 마세요.

# 상담 기록을 받아 적는 구글 스프레드시트 (Apps Script 웹앱 주소)
SHEETS_WEBHOOK_URL=
# 위 주소를 보호하는 공용 암호. docs/apps-script.gs 의 SECRET 과 같아야 합니다.
SHEETS_WEBHOOK_SECRET=

# 알림 메일을 보내는 계정 (Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 상담 신청 알림을 받을 주소
NOTIFY_TO=
